<UserControl x:Class="StockMonitor.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:behaviors="clr-namespace:StockMonitor.Behaviors"
             xmlns:services="clr-namespace:StockMonitor.Services"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="320" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <syncfusion:SfChart Grid.Row="0"
                            Header="{Binding [Chart_PortfolioHistory], Source={x:Static services:LocalizationService.Instance}}"
                            ToolTip="{Binding [Tip_ChartHistory], Source={x:Static services:LocalizationService.Instance}}"
                            Margin="0,0,0,8">
            <syncfusion:SfChart.Legend>
                <syncfusion:ChartLegend DockPosition="Top" />
            </syncfusion:SfChart.Legend>
            <syncfusion:SfChart.PrimaryAxis>
                <syncfusion:DateTimeAxis Header="{Binding [Axis_Date], Source={x:Static services:LocalizationService.Instance}}" LabelFormat="yyyy-MM" />
            </syncfusion:SfChart.PrimaryAxis>
            <syncfusion:SfChart.SecondaryAxis>
                <syncfusion:NumericalAxis Header="{Binding [Axis_ValueBase], Source={x:Static services:LocalizationService.Instance}}" />
            </syncfusion:SfChart.SecondaryAxis>
            <syncfusion:SfChart.Behaviors>
                <syncfusion:ChartTrackBallBehavior />
            </syncfusion:SfChart.Behaviors>

            <syncfusion:SplineAreaSeries ItemsSource="{Binding PortfolioHistory}"
                                         XBindingPath="Date"
                                         YBindingPath="TotalPortfolioValueBase"
                                         Label="{Binding [Series_TotalPortValue], Source={x:Static services:LocalizationService.Instance}}"
                                         ShowTooltip="True" />
            <syncfusion:FastLineSeries ItemsSource="{Binding PortfolioHistory}"
                                       XBindingPath="Date"
                                       YBindingPath="CumulativeInvestedBase"
                                       Label="{Binding [Series_ActiveInvested], Source={x:Static services:LocalizationService.Instance}}"
                                       StrokeThickness="2" />
            <syncfusion:FastLineSeries ItemsSource="{Binding PortfolioHistory}"
                                       XBindingPath="Date"
                                       YBindingPath="CumulativeNetDividendsBase"
                                       Label="{Binding [Series_CumNetDividends], Source={x:Static services:LocalizationService.Instance}}"
                                       StrokeThickness="2" />
        </syncfusion:SfChart>

        <syncfusion:SfDataGrid Grid.Row="1"
                               ItemsSource="{Binding PortfolioHistory}"
                               behaviors:MvvmBehaviors.ClearFiltersRequest="{Binding ClearFiltersRequest}"
                               ToolTip="{Binding [Tip_HistoryGrid], Source={x:Static services:LocalizationService.Instance}}"
                               AutoGenerateColumns="False"
                               AllowSorting="True"
                               AllowFiltering="True"
                               AllowResizingColumns="True">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridDateTimeColumn MappingName="Date" HeaderText="{Binding [Col_Date], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_Date" Pattern="CustomPattern" CustomPattern="yyyy-MM-dd" Width="115" />
                <syncfusion:GridTextColumn MappingName="BaseCurrency" HeaderText="{Binding [Col_BaseCurrency], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_BaseCurrency" Width="80" />
                <syncfusion:GridNumericColumn MappingName="CumulativeDepositsBase" HeaderText="{Binding [Col_CumDeposits], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_CumDeposits" NumberDecimalDigits="2" Width="175" />
                <syncfusion:GridNumericColumn MappingName="CumulativeInvestedBase" HeaderText="{Binding [Col_ActiveInvested], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_ActiveInvested" NumberDecimalDigits="2" Width="155" />
                <syncfusion:GridNumericColumn MappingName="HoldingsMarketValueBase" HeaderText="{Binding [Col_HoldingsVal], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_HoldingsVal" NumberDecimalDigits="2" Width="165" />
                <syncfusion:GridNumericColumn MappingName="RealizedCapitalProfitBase" HeaderText="{Binding [Col_RealizedPL], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_RealizedPL" NumberDecimalDigits="2" Width="165" />
                <syncfusion:GridNumericColumn MappingName="CumulativeNetDividendsBase" HeaderText="{Binding [Col_CumNetDiv], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_CumNetDiv" NumberDecimalDigits="2" Width="185" />
                <syncfusion:GridNumericColumn MappingName="CumulativeNetInterestBase" HeaderText="{Binding [Col_CumNetInterest], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_CumNetInterest" NumberDecimalDigits="2" Width="180" />
                <syncfusion:GridNumericColumn MappingName="TotalPortfolioValueBase" HeaderText="{Binding [Col_TotalPortVal], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_TotalPortVal" NumberDecimalDigits="2" Width="145" />
                <syncfusion:GridNumericColumn MappingName="TotalProfitBase" HeaderText="{Binding [Col_TotalProfitBase], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_TotalProfitBase" NumberDecimalDigits="2" Width="145" />
                <syncfusion:GridNumericColumn MappingName="TotalReturnPercent" HeaderText="{Binding [Col_ReturnPct], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_ReturnPct" NumberDecimalDigits="2" Width="115" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
    </Grid>
</UserControl>
