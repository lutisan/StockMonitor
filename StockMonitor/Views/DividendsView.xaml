<UserControl x:Class="StockMonitor.Views.DividendsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:sfgrid="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
             xmlns:behaviors="clr-namespace:StockMonitor.Behaviors"
             xmlns:services="clr-namespace:StockMonitor.Services"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="240" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <syncfusion:SfChart Grid.Row="0"
                            Header="{Binding [Chart_AnnualDividends], Source={x:Static services:LocalizationService.Instance}}"
                            ToolTip="{Binding [Tip_ChartAnnualDiv], Source={x:Static services:LocalizationService.Instance}}"
                            Margin="0,0,0,8">
            <syncfusion:SfChart.Legend>
                <syncfusion:ChartLegend DockPosition="Top" />
            </syncfusion:SfChart.Legend>
            <syncfusion:SfChart.PrimaryAxis>
                <syncfusion:CategoryAxis Header="{Binding [Axis_Year], Source={x:Static services:LocalizationService.Instance}}" />
            </syncfusion:SfChart.PrimaryAxis>
            <syncfusion:SfChart.SecondaryAxis>
                <syncfusion:NumericalAxis Header="{Binding [Axis_AmountBase], Source={x:Static services:LocalizationService.Instance}}"
                                          behaviors:MvvmBehaviors.UseSpaceNumberAxisLabels="True" />
            </syncfusion:SfChart.SecondaryAxis>
            <syncfusion:ColumnSeries ItemsSource="{Binding YearlyDividendsChart}"
                                     XBindingPath="Label"
                                     YBindingPath="ValueBase"
                                     Label="{Binding [Series_NetDivBase], Source={x:Static services:LocalizationService.Instance}}"
                                     ShowTooltip="True">
                <syncfusion:ColumnSeries.TooltipTemplate>
                    <DataTemplate>
                        <Border Padding="8,5" BorderThickness="1" CornerRadius="3" Background="#E61E293B" BorderBrush="#64748B">
                            <StackPanel>
                                <TextBlock Text="{Binding Series.Label}" Foreground="#94A3B8" FontSize="11" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Item.Label}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text=": " Foreground="#94A3B8" FontSize="12" />
                                    <TextBlock Text="{Binding Item.ValueBase, Converter={StaticResource SpaceNum}, ConverterParameter=N2}" Foreground="White" FontWeight="Bold" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </syncfusion:ColumnSeries.TooltipTemplate>
            </syncfusion:ColumnSeries>
            <syncfusion:ColumnSeries ItemsSource="{Binding YearlyDividendsChart}"
                                     XBindingPath="Label"
                                     YBindingPath="SharePercent"
                                     Label="{Binding [Series_WhtBase], Source={x:Static services:LocalizationService.Instance}}"
                                     ShowTooltip="True">
                <syncfusion:ColumnSeries.TooltipTemplate>
                    <DataTemplate>
                        <Border Padding="8,5" BorderThickness="1" CornerRadius="3" Background="#E61E293B" BorderBrush="#64748B">
                            <StackPanel>
                                <TextBlock Text="{Binding Series.Label}" Foreground="#94A3B8" FontSize="11" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Item.Label}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text=": " Foreground="#94A3B8" FontSize="12" />
                                    <TextBlock Text="{Binding Item.SharePercent, Converter={StaticResource SpaceNum}, ConverterParameter=N2}" Foreground="White" FontWeight="Bold" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </syncfusion:ColumnSeries.TooltipTemplate>
            </syncfusion:ColumnSeries>
        </syncfusion:SfChart>

        <syncfusion:SfDataGrid Grid.Row="1"
                               ItemsSource="{Binding Dividends}"
                               behaviors:MvvmBehaviors.ClearFiltersRequest="{Binding ClearFiltersRequest}"
                               ToolTip="{Binding [Tip_DividendsGrid], Source={x:Static services:LocalizationService.Instance}}"
                               AutoGenerateColumns="False"
                               AllowGrouping="True"
                               ShowGroupDropArea="True"
                               AllowSorting="True"
                               AllowFiltering="True"
                               AllowResizingColumns="True">
            <syncfusion:SfDataGrid.CellStyle>
                <Style TargetType="sfgrid:GridCell">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPositionClosed}" Value="True">
                            <Setter Property="Opacity" Value="0.62" />
                            <Setter Property="FontStyle" Value="Italic" />
                            <Setter Property="Background" Value="#1464748B" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </syncfusion:SfDataGrid.CellStyle>
            <syncfusion:SfDataGrid.TableSummaryRows>
                <syncfusion:GridTableSummaryRow ShowSummaryInRow="False" Position="Bottom">
                    <syncfusion:GridSummaryRow.SummaryColumns>
                        <syncfusion:GridSummaryColumn Name="DivCount" MappingName="CompanyName" SummaryType="CountAggregate" Format="'Payments: {Count}'" />
                        <syncfusion:GridSummaryColumn Name="DivGross" MappingName="GrossAmountBase" SummaryType="DoubleAggregate" Format="'{Sum:N2}'" />
                        <syncfusion:GridSummaryColumn Name="DivTax" MappingName="WithholdingTaxBase" SummaryType="DoubleAggregate" Format="'{Sum:N2}'" />
                        <syncfusion:GridSummaryColumn Name="DivNet" MappingName="NetAmountBase" SummaryType="DoubleAggregate" Format="'{Sum:N2}'" />
                    </syncfusion:GridSummaryRow.SummaryColumns>
                </syncfusion:GridTableSummaryRow>
            </syncfusion:SfDataGrid.TableSummaryRows>

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridDateTimeColumn MappingName="PayDate" HeaderText="{Binding [Col_PayDate], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_PayDate" Pattern="CustomPattern" CustomPattern="yyyy-MM-dd HH:mm" Width="135" />
                <syncfusion:GridTextColumn MappingName="CompanyName" HeaderText="{Binding [Col_CompanyName], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_CompanyName" Width="180" />
                <syncfusion:GridTextColumn MappingName="Ticker" HeaderText="{Binding [Col_Ticker], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_Ticker" Width="90" />
                <syncfusion:GridNumericColumn MappingName="DividendPerShareNative" HeaderText="{Binding [Col_DivPerShare], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_DivPerShare" NumberDecimalDigits="4" AllowNullValue="True" Width="118" />
                <syncfusion:GridTextColumn MappingName="NativeCurrency" HeaderText="{Binding [Col_DivCcy], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_DivCcy" Width="95" />
                <syncfusion:GridTextColumn MappingName="BaseCurrency" HeaderText="{Binding [Col_BaseCurrency], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_BaseCurrency" Width="80" />
                <syncfusion:GridNumericColumn MappingName="GrossAmountBase" HeaderText="{Binding [Col_GrossDivBase], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_GrossDivBase" NumberDecimalDigits="2" Width="130" />
                <syncfusion:GridNumericColumn MappingName="TaxRatePercent" HeaderText="{Binding [Col_TaxRatePct], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_TaxRatePct" NumberDecimalDigits="2" Width="95" />
                <syncfusion:GridNumericColumn MappingName="WithholdingTaxBase" HeaderText="{Binding [Col_WhtBase], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_WhtBase" NumberDecimalDigits="2" Width="110" />
                <syncfusion:GridNumericColumn MappingName="NetAmountBase" HeaderText="{Binding [Col_NetDivBase], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_NetDivBase" NumberDecimalDigits="2" Width="130" />
                <syncfusion:GridNumericColumn MappingName="AnnualizedYieldPercent" HeaderText="{Binding [Col_AnnualYieldPct], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_AnnualYieldPct" NumberDecimalDigits="2" Width="110" />
                <syncfusion:GridTextColumn MappingName="ExternalPositionId" HeaderText="{Binding [Col_PosId], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_PosId" Width="115" />
                <syncfusion:GridTextColumn MappingName="SourceLabel" HeaderText="{Binding [Col_Source], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_Source" Width="95" />
                <syncfusion:GridTextColumn MappingName="Comment" HeaderText="{Binding [Col_Comment], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_Comment" Width="260" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
    </Grid>
</UserControl>
