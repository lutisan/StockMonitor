<UserControl x:Class="StockMonitor.Views.SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:sfgrid="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
             xmlns:behaviors="clr-namespace:StockMonitor.Behaviors"
             xmlns:services="clr-namespace:StockMonitor.Services"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="240" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- KPI Tiles -->
        <UniformGrid Grid.Row="0" Columns="6" Margin="0,0,0,8">
            <Border Padding="10" Margin="0,0,6,0" BorderThickness="1"
                    ToolTip="{Binding [Tip_KpiOpenInvested], Source={x:Static services:LocalizationService.Instance}}">
                <StackPanel>
                    <TextBlock Text="{Binding [Kpi_OpenInvested], Source={x:Static services:LocalizationService.Instance}}" Opacity="0.75" FontSize="12" />
                    <TextBlock Text="{Binding OpenInvestedBase, StringFormat=N2}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding SelectedBaseCurrency}" Opacity="0.7" FontSize="11" />
                </StackPanel>
            </Border>
            <Border Padding="10" Margin="0,0,6,0" BorderThickness="1"
                    ToolTip="{Binding [Tip_KpiOpenMarketVal], Source={x:Static services:LocalizationService.Instance}}">
                <StackPanel>
                    <TextBlock Text="{Binding [Kpi_OpenMarketVal], Source={x:Static services:LocalizationService.Instance}}" Opacity="0.75" FontSize="12" />
                    <TextBlock Text="{Binding OpenMarketValueBase, StringFormat=N2}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding SelectedBaseCurrency}" Opacity="0.7" FontSize="11" />
                </StackPanel>
            </Border>
            <Border Padding="10" Margin="0,0,6,0" BorderThickness="1"
                    ToolTip="{Binding [Tip_KpiCapitalGain], Source={x:Static services:LocalizationService.Instance}}">
                <StackPanel>
                    <TextBlock Text="{Binding [Kpi_CapitalGain], Source={x:Static services:LocalizationService.Instance}}" Opacity="0.75" FontSize="12" />
                    <TextBlock Text="{Binding TotalCapitalProfitBase, StringFormat=N2}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ClosedRealizedProfitBase, StringFormat='Closed Realized: {0:N2}'}" Opacity="0.7" FontSize="11" />
                </StackPanel>
            </Border>
            <Border Padding="10" Margin="0,0,6,0" BorderThickness="1"
                    ToolTip="{Binding [Tip_KpiNetDividends], Source={x:Static services:LocalizationService.Instance}}">
                <StackPanel>
                    <TextBlock Text="{Binding [Kpi_NetDividends], Source={x:Static services:LocalizationService.Instance}}" Opacity="0.75" FontSize="12" />
                    <TextBlock Text="{Binding TotalNetDividendsBase, StringFormat=N2}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding TotalWithholdingTaxBase, StringFormat='Withholding Tax: -{0:N2}'}" Opacity="0.7" FontSize="11" />
                </StackPanel>
            </Border>
            <Border Padding="10" Margin="0,0,6,0" BorderThickness="1"
                    ToolTip="{Binding [Tip_KpiTotalProfit], Source={x:Static services:LocalizationService.Instance}}">
                <StackPanel>
                    <TextBlock Text="{Binding [Kpi_TotalProfit], Source={x:Static services:LocalizationService.Instance}}" Opacity="0.75" FontSize="12" />
                    <TextBlock Text="{Binding TotalOverallProfitBase, StringFormat=N2}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding TotalFreeFundsInterestBase, StringFormat='Free-Funds Interest: +{0:N2}'}" Opacity="0.7" FontSize="11" />
                </StackPanel>
            </Border>
            <Border Padding="10" BorderThickness="1"
                    ToolTip="{Binding [Tip_KpiTotalReturn], Source={x:Static services:LocalizationService.Instance}}">
                <StackPanel>
                    <TextBlock Text="{Binding [Kpi_TotalReturn], Source={x:Static services:LocalizationService.Instance}}" Opacity="0.75" FontSize="12" />
                    <TextBlock Text="{Binding TotalOverallReturnPercent, StringFormat='{}{0:N2} %'}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding TotalDepositsBase, StringFormat='Cash Deposits: {0:N2}'}" Opacity="0.7" FontSize="11" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Allocation Doughnut Charts -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.Resources>
                <DataTemplate x:Key="AllocationTooltipTemplate">
                    <Border Padding="8,5" BorderThickness="1" CornerRadius="3" Background="#E61E293B" BorderBrush="#64748B">
                        <StackPanel>
                            <TextBlock Text="{Binding Item.Label}" FontWeight="Bold" Foreground="White" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding Item.ValueBase, StringFormat=N2}" Foreground="#E2E8F0" FontWeight="SemiBold" />
                                <TextBlock Text=" (" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding Item.SharePercent, StringFormat={}{0:N2}%}" Foreground="#38BDF8" FontWeight="SemiBold" />
                                <TextBlock Text=")" Foreground="#94A3B8" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <syncfusion:SfChart Grid.Column="0"
                                Header="{Binding [Chart_AllocCompany], Source={x:Static services:LocalizationService.Instance}}"
                                ToolTip="{Binding [Tip_ChartAllocCompany], Source={x:Static services:LocalizationService.Instance}}"
                                Margin="0,0,6,0">
                <syncfusion:SfChart.Legend>
                    <syncfusion:ChartLegend DockPosition="Right" />
                </syncfusion:SfChart.Legend>
                <syncfusion:DoughnutSeries ItemsSource="{Binding AllocationByInstrument}"
                                           XBindingPath="Label"
                                           YBindingPath="ValueBase"
                                           TooltipTemplate="{StaticResource AllocationTooltipTemplate}"
                                           ShowTooltip="True" />
            </syncfusion:SfChart>

            <syncfusion:SfChart Grid.Column="1"
                                Header="{Binding [Chart_AllocCountry], Source={x:Static services:LocalizationService.Instance}}"
                                ToolTip="{Binding [Tip_ChartAllocCountry], Source={x:Static services:LocalizationService.Instance}}"
                                Margin="6,0,0,0">
                <syncfusion:SfChart.Legend>
                    <syncfusion:ChartLegend DockPosition="Right" />
                </syncfusion:SfChart.Legend>
                <syncfusion:DoughnutSeries ItemsSource="{Binding AllocationByCountry}"
                                           XBindingPath="Label"
                                           YBindingPath="ValueBase"
                                           TooltipTemplate="{StaticResource AllocationTooltipTemplate}"
                                           ShowTooltip="True" />
            </syncfusion:SfChart>
        </Grid>

        <!-- Detailed Summary Grid -->
        <syncfusion:SfDataGrid Grid.Row="2"
                               ItemsSource="{Binding FilteredLots}"
                               ToolTip="{Binding [Tip_SummaryGrid], Source={x:Static services:LocalizationService.Instance}}"
                               AutoGenerateColumns="False"
                               AllowGrouping="True"
                               ShowGroupDropArea="True"
                               AllowSorting="True"
                               AllowFiltering="True"
                               AllowResizingColumns="True">
            <syncfusion:SfDataGrid.Resources>
                <Style x:Key="SummaryLotCellStyle" TargetType="sfgrid:GridCell">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInProfit}" Value="True">
                            <Setter Property="Background" Value="#1422C55E" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInLoss}" Value="True">
                            <Setter Property="Background" Value="#14EF4444" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsClosed}" Value="True">
                            <Setter Property="Opacity" Value="0.62" />
                            <Setter Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="SummaryProfitLossCellStyle" TargetType="sfgrid:GridCell" BasedOn="{StaticResource SummaryLotCellStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInProfit}" Value="True">
                            <Setter Property="Foreground" Value="#22C55E" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInLoss}" Value="True">
                            <Setter Property="Foreground" Value="#EF4444" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </syncfusion:SfDataGrid.Resources>
            <syncfusion:SfDataGrid.CellStyle>
                <StaticResource ResourceKey="SummaryLotCellStyle" />
            </syncfusion:SfDataGrid.CellStyle>
            <syncfusion:SfDataGrid.TableSummaryRows>
                <syncfusion:GridTableSummaryRow ShowSummaryInRow="False" Position="Bottom">
                    <syncfusion:GridSummaryRow.SummaryColumns>
                        <syncfusion:GridSummaryColumn Name="SumInvested" MappingName="OpenCostBase" SummaryType="DoubleAggregate" Format="'{Sum:N2}'" />
                        <syncfusion:GridSummaryColumn Name="SumMarket" MappingName="CloseOrCurrentValueBase" SummaryType="DoubleAggregate" Format="'{Sum:N2}'" />
                        <syncfusion:GridSummaryColumn Name="SumCapGain" MappingName="CapitalProfitLossBase" SummaryType="DoubleAggregate" Format="'{Sum:N2}'" />
                        <syncfusion:GridSummaryColumn Name="SumGrossDiv" MappingName="GrossDividends" SummaryType="DoubleAggregate" Format="'{Sum:N2}'" />
                        <syncfusion:GridSummaryColumn Name="SumWht" MappingName="WithholdingTax" SummaryType="DoubleAggregate" Format="'{Sum:N2}'" />
                        <syncfusion:GridSummaryColumn Name="SumNetDiv" MappingName="NetDividendsBase" SummaryType="DoubleAggregate" Format="'{Sum:N2}'" />
                        <syncfusion:GridSummaryColumn Name="SumTotalProfit" MappingName="TotalProfitBase" SummaryType="DoubleAggregate" Format="'{Sum:N2}'" />
                    </syncfusion:GridSummaryRow.SummaryColumns>
                </syncfusion:GridTableSummaryRow>
            </syncfusion:SfDataGrid.TableSummaryRows>

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn MappingName="CompanyName" HeaderText="{Binding [Col_CompanyName], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_CompanyName" Width="185" />
                <syncfusion:GridTextColumn MappingName="Ticker" HeaderText="{Binding [Col_Ticker], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_Ticker" Width="90" />
                <syncfusion:GridTextColumn MappingName="StockCurrency" HeaderText="{Binding [Col_Currency], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_Currency" Width="78" />
                <syncfusion:GridTextColumn MappingName="BaseCurrency" HeaderText="{Binding [Col_BaseCurrency], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_BaseCurrency" Width="78" />
                <syncfusion:GridTextColumn MappingName="StatusText" HeaderText="{Binding [Col_Status], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_Status" Width="75" />
                <syncfusion:GridDateTimeColumn MappingName="OpenDate" HeaderText="{Binding [Col_OpenDate], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_OpenDate" Pattern="CustomPattern" CustomPattern="yyyy-MM-dd" Width="105" />
                <syncfusion:GridNumericColumn MappingName="Quantity" HeaderText="{Binding [Col_Quantity], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_Quantity" NumberDecimalDigits="2" Width="85" />
                <syncfusion:GridNumericColumn MappingName="OpenCostBase" HeaderText="{Binding [Col_OpenCostBase], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_OpenCostBase" NumberDecimalDigits="2" Width="145" />
                <syncfusion:GridNumericColumn MappingName="CloseOrCurrentValueBase" HeaderText="{Binding [Col_MarketValBase], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_MarketValBase" NumberDecimalDigits="2" Width="155" />
                <syncfusion:GridNumericColumn MappingName="CapitalProfitLossBase" HeaderText="{Binding [Col_DiffBase], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_DiffBase" CellStyle="{StaticResource SummaryProfitLossCellStyle}" NumberDecimalDigits="2" Width="135" />
                <syncfusion:GridNumericColumn MappingName="GrossDividends" HeaderText="{Binding [Col_GrossDivBase], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_GrossDivBase" NumberDecimalDigits="2" Width="145" />
                <syncfusion:GridNumericColumn MappingName="WithholdingTax" HeaderText="{Binding [Col_WhtBase], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_WhtBase" NumberDecimalDigits="2" Width="145" />
                <syncfusion:GridNumericColumn MappingName="NetDividendsBase" HeaderText="{Binding [Col_NetDivBase], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_NetDivBase" NumberDecimalDigits="2" Width="140" />
                <syncfusion:GridNumericColumn MappingName="SpinoffProceedsBase" HeaderText="{Binding [Col_SpinoffsBase], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_SpinoffsBase" NumberDecimalDigits="2" Width="115" />
                <syncfusion:GridNumericColumn MappingName="TotalProfitBase" HeaderText="{Binding [Col_TotalProfitBase], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_TotalProfitBase" CellStyle="{StaticResource SummaryProfitLossCellStyle}" NumberDecimalDigits="2" Width="135" />
                <syncfusion:GridNumericColumn MappingName="TotalReturnPercent" HeaderText="{Binding [Col_ReturnPct], Source={x:Static services:LocalizationService.Instance}}" behaviors:GridColumnHelp.ToolTipKey="Tip_Col_ReturnPct" CellStyle="{StaticResource SummaryProfitLossCellStyle}" NumberDecimalDigits="2" Width="105" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
    </Grid>
</UserControl>
