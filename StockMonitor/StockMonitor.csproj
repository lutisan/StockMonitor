<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NuGetAudit>false</NuGetAudit>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StockMonitor.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(SYNCFUSION_LICENSE_KEY)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SyncfusionLicenseKey</_Parameter1>
      <_Parameter2>$(SYNCFUSION_LICENSE_KEY)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Syncfusion.UI.WPF.NET" Version="31.1.17" />
    <PackageReference Include="Syncfusion.Themes.Windows11Dark.WPF" Version="31.1.17" />
    <PackageReference Include="Syncfusion.Themes.Windows11Light.WPF" Version="31.1.17" />
    <PackageReference Include="Syncfusion.Themes.Material3Dark.WPF" Version="31.1.17" />
    <PackageReference Include="Syncfusion.Themes.Material3Light.WPF" Version="31.1.17" />
    <PackageReference Include="Syncfusion.Themes.MaterialDark.WPF" Version="31.1.17" />
    <PackageReference Include="Syncfusion.Themes.MaterialDarkBlue.WPF" Version="31.1.17" />
    <PackageReference Include="Syncfusion.Themes.MaterialLight.WPF" Version="31.1.17" />
    <PackageReference Include="Syncfusion.Themes.MaterialLightBlue.WPF" Version="31.1.17" />
    <PackageReference Include="Syncfusion.Themes.Office2019Black.WPF" Version="31.1.17" />
    <PackageReference Include="Syncfusion.Themes.Office2019Colorful.WPF" Version="31.1.17" />
    <PackageReference Include="Syncfusion.Themes.Office2019DarkGray.WPF" Version="31.1.17" />
    <PackageReference Include="Syncfusion.Themes.Office2019White.WPF" Version="31.1.17" />
    <PackageReference Include="Syncfusion.Themes.Office2019HighContrast.WPF" Version="31.1.17" />
    <PackageReference Include="Syncfusion.Themes.VisualStudio2015.WPF" Version="31.1.17" />
    <PackageReference Include="Syncfusion.Themes.VisualStudio2013.WPF" Version="31.1.17" />
    <PackageReference Include="Syncfusion.Themes.Metro.WPF" Version="31.1.17" />
    <PackageReference Include="Syncfusion.Themes.Blend.WPF" Version="31.1.17" />
    <PackageReference Include="Syncfusion.Themes.Saffron.WPF" Version="31.1.17" />
    <PackageReference Include="Syncfusion.Themes.Lime.WPF" Version="31.1.17" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StockMonitor.Core\StockMonitor.Core.csproj" />
    <ProjectReference Include="..\StockMonitor.Export.Default\StockMonitor.Export.Default.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\StockMonitor.Export.Pdf\StockMonitor.Export.Pdf.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\StockMonitor.Import.Xtb\StockMonitor.Import.Xtb.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\xtb_seed.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyPlugins" AfterTargets="Build">
    <ItemGroup>
      <_ExportPluginFiles Include="..\StockMonitor.Export.Default\bin\$(Configuration)\$(TargetFramework)\StockMonitor.Export.Default.export.dll" />
      <_ExportPluginFiles Include="..\StockMonitor.Export.Default\bin\$(Configuration)\$(TargetFramework)\StockMonitor.Export.Default.export.pdb" />
      <_ExportPluginFiles Include="..\StockMonitor.Export.Default\bin\$(Configuration)\$(TargetFramework)\StockMonitor.Export.Default.export.deps.json" />
      <_ExportPluginFiles Include="..\StockMonitor.Export.Pdf\bin\$(Configuration)\$(TargetFramework)\StockMonitor.Export.Pdf.export.dll" />
      <_ExportPluginFiles Include="..\StockMonitor.Export.Pdf\bin\$(Configuration)\$(TargetFramework)\StockMonitor.Export.Pdf.export.pdb" />
      <_ExportPluginFiles Include="..\StockMonitor.Export.Pdf\bin\$(Configuration)\$(TargetFramework)\StockMonitor.Export.Pdf.export.deps.json" />
      <_ImportPluginFiles Include="..\StockMonitor.Import.Xtb\bin\$(Configuration)\$(TargetFramework)\StockMonitor.Import.Xtb.import.dll" />
      <_ImportPluginFiles Include="..\StockMonitor.Import.Xtb\bin\$(Configuration)\$(TargetFramework)\StockMonitor.Import.Xtb.import.pdb" />
      <_ImportPluginFiles Include="..\StockMonitor.Import.Xtb\bin\$(Configuration)\$(TargetFramework)\StockMonitor.Import.Xtb.import.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_ExportPluginFiles)"
          DestinationFolder="$(TargetDir)Exports"
          SkipUnchangedFiles="true"
          Condition="Exists('%(FullPath)')" />
    <Copy SourceFiles="@(_ImportPluginFiles)"
          DestinationFolder="$(TargetDir)Imports"
          SkipUnchangedFiles="true"
          Condition="Exists('%(FullPath)')" />
  </Target>

</Project>
