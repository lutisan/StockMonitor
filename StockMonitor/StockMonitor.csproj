<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NuGetAudit>false</NuGetAudit>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <SyncfusionAssemblyDir>C:\Program Files (x86)\Syncfusion\Essential Studio\WPF\31.1.17\precompiledassemblies\net9.0</SyncfusionAssemblyDir>
    <WebView2AssemblyDir>C:\Program Files\Microsoft Visual Studio\18\Community\Common7\IDE\PrivateAssemblies</WebView2AssemblyDir>
